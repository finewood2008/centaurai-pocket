# Backend
CENTAURAI_POCKET_HOST=127.0.0.1
CENTAURAI_POCKET_PORT=8718
# 空值会安全回退默认私有目录；不覆盖默认路径时建议不要定义此变量。
# CENTAURAI_POCKET_DATA_DIR=/absolute/path/to/centaurai-pocket-data
# 留空表示首次启动时在数据目录生成；生产环境也可显式注入。
CENTAURAI_POCKET_OWNER_TOKEN=
CENTAURAI_POCKET_AGENT_TOKEN=
CENTAURAI_POCKET_MAX_FILE_BYTES=20971520
# 设为 0 可关闭服务端自动同步调度。
CENTAURAI_POCKET_SCHEDULER_POLL_SECONDS=60
# 逗号分隔的精确 Origin；不要写路径或使用 *。MCP 带 Origin 时也复用此白名单。
CENTAURAI_POCKET_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
# 外部任务执行工作台默认关闭。只有部署了独立 HTTPS Origin 时才取消下一行注释；
# 末尾 / 会被去除，显式 :443、凭据、路径、query 或 fragment 会令 API 拒绝启动。
# CENTAURAI_POCKET_TASK_EXECUTION_PUBLIC_ORIGIN=https://tasks.example.com

# 秘书 Agent 模型编排（§3.4）。编排跑在 Pocket 服务端，手机端绝不持有模型密钥。
# 本地档：设为 ollama 启用；未配置时 /assistant/chat 返回 503，秘书端降级为确定性指令。
# CENTAURAI_POCKET_ASSISTANT_PROVIDER=ollama
# CENTAURAI_POCKET_ASSISTANT_MODEL=qwen2.5:14b
# CENTAURAI_POCKET_OLLAMA_URL=http://127.0.0.1:11434
# 云端档：仅在主人逐次签发授权票据后才会被调用；每次调用写 assistant.cloud_call 审计。
# CENTAURAI_POCKET_ASSISTANT_CLOUD_PROVIDER=anthropic
# CENTAURAI_POCKET_ASSISTANT_CLOUD_MODEL=claude-opus-5
# CENTAURAI_POCKET_ASSISTANT_CLOUD_API_KEY=
# CENTAURAI_POCKET_ASSISTANT_CLOUD_BASE_URL=https://api.anthropic.com

# Mobile build-time default. Real devices should use an HTTPS address.
EXPO_PUBLIC_POCKET_API_URL=http://127.0.0.1:8718
# 仅供受控开发构建；生产包不要启用非 loopback 明文 HTTP。
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false
